<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Upload NontonKu</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 20px;
      background: #10131a;
      color: #fff;
      font-family: Arial, sans-serif;
    }
    .container {
      max-width: 600px;
      margin: 30px auto;
      padding: 24px;
      background: #1b202b;
      border-radius: 14px;
    }
    h1 { margin-top: 0; }
    p { color: #c5cad5; line-height: 1.5; }
    label { display: block; margin: 18px 0 8px; }
    input, button {
      width: 100%;
      padding: 13px;
      border-radius: 8px;
      font-size: 16px;
    }
    input {
      border: 1px solid #414959;
      background: #10131a;
      color: white;
    }
    button {
      margin-top: 18px;
      border: 0;
      background: #e11d48;
      color: white;
      font-weight: bold;
    }
    button:disabled { opacity: .5; }
    #status { overflow-wrap: anywhere; }
  </style>
</head>
<body>
  <div class="container">
    <h1>Admin NontonKu</h1>
    <p>Upload video langsung ke Cloudflare Stream.</p>

    <label for="password">Password admin</label>
    <input id="password" type="password"
      placeholder="Masukkan password admin">

    <label for="video">Pilih file video</label>
    <input id="video" type="file" accept="video/*">

    <button id="upload">Upload Video</button>
    <p id="status">Halaman admin siap disiapkan.</p>
  </div>
</body>
</html>
